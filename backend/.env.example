AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_KB_ID=
S3_BUCKET_NAME=
OPENSEARCH_ENDPOINT=
COHERE_API_KEY=

# Used for chat/embedding calls (query rewriting, HyDE, final answer generation).
OPENAI_API_KEY=

# Optional: AWS Bedrock Guardrail applied to user queries and generated answers
# (prompt-injection / content moderation). Leave BEDROCK_GUARDRAIL_ID blank to
# disable — the check becomes a no-op with no guardrail provisioned.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Auth (AWS Cognito). tenant_id for every request comes from the logged-in
# user's Cognito group membership, not a client-supplied header.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_REGION=
# False for local http dev; must be True once served over https.
COOKIE_SECURE=True

# Chat history (DynamoDB). Conversations are scoped per-user (private),
# even though documents/KB are scoped per-tenant (shared across the org).
DYNAMODB_CONVERSATIONS_TABLE=
DYNAMODB_MESSAGES_TABLE=

# Observability (LangSmith). Traces the full RAG pipeline per query — query
# rewrite, HyDE, retrieve_from_kb (every chunk + score), rerank_with_cohere,
# guardrail checks, and the final generation — as one connected trace at
# https://smith.langchain.com, so a bad answer can be traced back to exactly
# which chunk/step caused it. Get an API key from your LangSmith account's
# settings. Leave LANGCHAIN_API_KEY blank (or TRACING_V2=false) to disable —
# every @traceable call becomes a no-op and the app behaves exactly as
# without this section.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-rag-bedrock

# Org invites (shareable, HMAC-signed join links). Generate a random value,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
INVITE_SIGNING_KEY=

# Email-delivered invites (AWS SES). The sender address must be a verified
# SES identity; until SES production access is granted, recipients must also
# be verified (sandbox mode). If SES isn't set up, invites still work — the
# admin dashboard falls back to showing a copyable link instead of emailing it.
SES_SENDER_EMAIL=
FRONTEND_BASE_URL=http://localhost:3000

